# Database
# Default: PostgreSQL local instance with database 'luna_c'
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/luna_c?schema=public"

# AI Provider Configuration
# Options: deepseek-api | qwen-local | mock
AI_PROVIDER="deepseek-api"

# DeepSeek API (required when AI_PROVIDER=deepseek-api)
DEEPSEEK_API_KEY="your-deepseek-api-key-here"

# Qwen Local (required when AI_PROVIDER=qwen-local)
QWEN_URL="http://localhost:8000/v1"

# Judge Configuration
# Options: auto | docker | local
JUDGE_MODE="auto"

# Judge Service URL (required when JUDGE_MODE=docker or local)
JUDGE_URL="http://localhost:8080"

# Authentication
# Must be at least 16 characters
JWT_SECRET="your-super-secret-jwt-key-min-16-chars"