# ============================================================
# Luna-C 环境变量模板
# 用法：copy .env.example .env （Windows）
# 注意：.env 含真实密钥，永不提交到 git。所有示例值均为占位。
# ============================================================

# --- 数据库 (必填) ---
# PostgreSQL 连接串。docker compose 起的库默认就是下面这组值。
# 无 Docker 时改为本地 Postgres 的地址，如
#   postgresql://postgres:postgres@localhost:5432/luna_c?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/luna_c?schema=public"

# --- AI 提供商 (选填，默认 deepseek-api) ---
# 可选值：
#   deepseek-api : 走 DeepSeek 官方 API（需 DEEPSEEK_API_KEY）
#   qwen-local   : 走本地 Qwen OpenAI 兼容端点（需 QWEN_URL）
#   mock         : 固定 Socratic 回复，无密钥也能全流程演示
AI_PROVIDER="mock"

# DeepSeek API Key（AI_PROVIDER=deepseek-api 时必填）
# 示例值占位，替换成你自己的 key；生产环境用环境变量注入，勿写死。
DEEPSEEK_API_KEY="sk-your-deepseek-key-here"

# Qwen 本地端点（AI_PROVIDER=qwen-local 时必填），OpenAI 兼容
# 示例：http://localhost:8000/v1
QWEN_URL="http://localhost:8000/v1"

# --- 判题模式 (选填，默认 auto) ---
# 可选值：
#   auto   : 优先 docker（需 daemon 可达 + gcc:13 镜像已存在），否则自动回退本地 gcc
#   docker : 强制容器判题，daemon/镜像缺失时直接报 JUDGE_INFRA（不静默回退、不误报 CE）
#   local  : 只用本地 MinGW gcc 子进程
# 探测顺序：显式 JUDGE_MODE 优先；auto 下先 `docker info` + `docker image inspect gcc:13`，
# 再试本地 gcc（PATH 或 LOCAL_GCC_PATH），二者皆无时返回 judge_unavailable（非 CE）。
JUDGE_MODE="auto"

# 本地 gcc 可执行文件路径（选填；JUDGE_MODE=auto/local 且 gcc 不在 PATH 时使用）
# Windows MinGW 示例：LOCAL_GCC_PATH="C:\mingw64\bin\gcc.exe"
# 不设置时默认用 PATH 中的 `gcc`。切勿提交本机绝对路径到 git。
# LOCAL_GCC_PATH=

# 远程判题服务地址（预留；MVP 阶段用本地容器/子进程，可不配）
JUDGE_URL="http://localhost:8080"

# --- 认证 (必填) ---
# JWT HS256 签名密钥，至少 16 字符，生产环境务必换成随机长字符串
# 生成示例（PowerShell）： -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET="change-me-to-a-long-random-string-min-16-chars"
