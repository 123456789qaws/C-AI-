// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  TA
  ADMIN
}

model User {
  id             String   @id // 学号/工号
  role           Role
  name           String
  passwordHash   String?  @db.Text // bcrypt hash, null for school-IAM users
  classesTaught  Class[]  @relation("ClassTeacher")
  enrollments    ClassEnrollment[]
  assignments    TaskAssignment[]
  authoredTasks  Task[]   @relation("TaskAuthor")
}

model Task {
  id             String   @id // fib_L2
  title          String
  intro          String?  @db.Text
  checkpointMode String   @default("sequential") @db.VarChar(20)
  authorId       String?
  author         User?    @relation("TaskAuthor", fields: [authorId], references: [id])
  checkpoints    Json     // 存 Gate DSL
  hiddenTests    Json
  assignments    TaskAssignment[]
}

model Class {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  teacherId    String
  createdAt    DateTime @default(now())
  teacher      User     @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments  ClassEnrollment[]
  assignments  TaskAssignment[]
}

model ClassEnrollment {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  joinedAt  DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
}

model TaskAssignment {
  id          String   @id @default(cuid())
  taskId      String
  classId     String
  teacherId   String
  deadline    DateTime?
  assignedAt  DateTime @default(now())
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([taskId])
}

model AiInteractionLog {
  id            String   @id @default(cuid())
  studentId     String
  taskId        String
  checkpointId  String
  ts            DateTime @default(now())
  role          String   // user | assistant | system
  promptText    String?  @db.Text
  aiReply       String?  @db.Text
  codeBefore    String?  @db.Text
  codeAfter     String?  @db.Text
  codeDiff      String?  @db.Text // patch
  gateResult    String   // passed | failed | escalated
  gateType      String   // regex | ai_socratic | test_pass
  model         String   // qwen2.5-coder:7b | deepseek-api
  tokens        Int?
  confidence    Float?
  sessionId     String   // 便于回放

  @@index([studentId, taskId, ts])
}

model CheckpointProgress {
  studentId     String
  taskId        String
  checkpointId  String
  passed        Boolean
  attempts      Int          @default(0)
  unlockedAt    DateTime?

  @@id([studentId, taskId, checkpointId])
}